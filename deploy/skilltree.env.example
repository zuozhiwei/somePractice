# Copy to /etc/skilltree.env and restrict permissions to root and the service user.
SKILLTREE_LISTEN=127.0.0.1:8081
SKILLTREE_DB=/var/lib/skilltree/skilltree.db
SKILLTREE_TIMEZONE=UTC
# Base64 encoded HMAC key, at least 32 decoded bytes. Required.
SKILLTREE_JWT_SECRET=
# Optional integrations
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_UPLOAD_HOST=https://upload-z1.qiniup.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
